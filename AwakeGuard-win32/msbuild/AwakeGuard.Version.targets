<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Patches app.manifest with AwakeGuardManifestVersion from Directory.Build.props -->
  <PropertyGroup>
    <AwakeGuardPatchedManifest>$(IntDir)AwakeGuard.app.manifest</AwakeGuardPatchedManifest>
  </PropertyGroup>

  <!-- AdditionalManifestFiles is mt.exe (Manifest tool) metadata, not Link metadata.
       Under <Link> it was silently ignored, so the exe shipped with no comctl32 v6
       dependency (no SysLink controls) and no DPI awareness. -->
  <ItemDefinitionGroup>
    <Manifest>
      <AdditionalManifestFiles>$(AwakeGuardPatchedManifest);%(AdditionalManifestFiles)</AdditionalManifestFiles>
    </Manifest>
  </ItemDefinitionGroup>

  <Target Name="AwakeGuardPrepareManifest" BeforeTargets="Link">
    <MakeDir Directories="$(IntDir)" Condition="!Exists('$(IntDir)')" />
    <Copy SourceFiles="$(ProjectDir)app.manifest" DestinationFiles="$(AwakeGuardPatchedManifest)" />
    <Exec Command="powershell -NoProfile -Command &quot;(Get-Content -LiteralPath '$(AwakeGuardPatchedManifest)') -replace 'AWAKEGUARD_MANIFEST_VERSION', '$(AwakeGuardManifestVersion)' | Set-Content -LiteralPath '$(AwakeGuardPatchedManifest)' -Encoding UTF8&quot;" />
  </Target>
</Project>
